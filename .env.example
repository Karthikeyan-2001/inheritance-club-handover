# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `pnpm db:start` (Supabase CLI).

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SERVER-ONLY: never prefix with NEXT_PUBLIC_, never import in client code) ---
# Secret key (sb_secret_...). The legacy "service_role" key also works.
# Used by the seed script and tests, and on the server for the LLM response cache (llm_cache).
SUPABASE_SECRET_KEY=

# --- Demo accounts ---
# Password shared by the four synthetic demo users. It is shown on the login
# page on purpose (the data is synthetic); RLS still applies to every account.
DEMO_USER_PASSWORD=

# --- LLM (server-only) ---
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_STRONG=claude-sonnet-5-5
# anthropic (default) or fake (offline rule-based stand-in; refused in production)
LLM_PROVIDER=anthropic
# Uncached model calls allowed per IST day across the whole app
LLM_MAX_CALLS_PER_DAY=500
