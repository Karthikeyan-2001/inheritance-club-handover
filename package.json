{
  "name": "inheritance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:rls": "RLS_REQUIRED=1 vitest run --project rls",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --remote",
    "gen:scenario": "node scripts/generate-scenario.ts",
    "seed": "node --env-file=.env.local scripts/seed.ts",
    "db:types": "supabase gen types --schema public > src/lib/supabase/database.types.ts",
    "seed:hosted": "node --env-file=.env.hosted.local scripts/seed.ts --remote",
    "eval:extract": "node --use-system-ca --env-file=.env.local scripts/eval-extract.ts",
    "eval:pipeline": "node --use-system-ca --env-file=.env.local scripts/eval-pipeline.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "whatsapp-chat-parser": "^4.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.23.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x"
  }
}
